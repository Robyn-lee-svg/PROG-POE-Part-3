@model List<RaceDay.Web.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Manage Categories</h1>
        <p class="lead">View and manage categories for your sporting events.</p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No categories are currently available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var category in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @category.CategoryName
                            </h5>

                            <p class="card-text">
                                @(string.IsNullOrWhiteSpace(category.Description)
                                                        ? "No description available."
                                                        : category.Description)
                    </p>

                            <p>
                                <strong>Event ID:</strong>
                                @category.EventID
                            </p>
                            <div class="mt-3">
                                <a asp-action="Edit"
                                   asp-route-id="@category.CategoryID"
                                   class="btn btn-warning">
                                    Edit Category
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@category.CategoryID"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this category?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger">
                                        Delete Category
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                }
        </div>
    }

    <div class="text-center mt-3">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Home
        </a>
    </div>
</div>

