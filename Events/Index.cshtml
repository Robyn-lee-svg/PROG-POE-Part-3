@model List<RaceDay.Web.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Upcoming Events</h1>
        <p class="lead">
            Discover sporting events and find your next challenge!
        </p>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">
            No events are currently available.
            Please check again later.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <span class="badge bg-primary mb-2">
                                @eventItem.EventType
                            </span>

                            <h5 class="card-title">
                                @eventItem.Name
                            </h5>

                            <p class="card-text">
                                @eventItem.Description
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>Distance:</strong>
                                @eventItem.Distance km
                            </p>

                            @if (Context.Session.GetString("Role") == "Organiser")
                            {
                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@eventItem.EventID"
                                   class="btn btn-warning mt-2">
                                    Edit Event
                                </a>

                                <form asp-controller="Events"
                                      asp-action="Delete"
                                      asp-route-id="@eventItem.EventID"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-danger mt-2">
                                        Delete Event
                                    </button>
                                </form>
                            }

                            @if (Context.Session.GetString("Role") == "Participant")
                            {
                                <a asp-controller="Enrolments"
                                   asp-action="Create"
                                   asp-route-eventId="@eventItem.EventID"
                                   class="btn btn-success mt-2">
                                    Enrol in Event
                                </a>
                            }
                           

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

