@{
    ViewData["Title"] = "RaceDay Home";

    var userID = Context.Session.GetInt32("UserID");
    var firstName = Context.Session.GetString("FirstName");
    var role = Context.Session.GetString("Role");
}

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 fw-bold">Welcome to RaceDay!</h1>

        <p class="lead">
            Your journey starts here. Discover events, challenge yourself
            and celebrate every achievement.
        </p>
    </div>

    @if (userID != null)
    {
        <div class="card shadow-sm mt-4 mx-auto" style="max-width: 600px;">
            <div class="card-body text-center p-4">
                <h2 class="h4">Welcome back, @firstName!</h2>

                <p class="text-muted">
                    You are logged in as a @role.
                </p>

                @if (role == "Organiser")
                {
                    <h3>Organiser Dashboard</h3>
                    <p>Manage your sporting events and participants.</p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary mt-3">
                        Manage Events
                    </a>

                    <a asp-controller="Events"
                       asp-action="Create"
                       class="btn btn-success mt-3">
                        Create New Event
                    </a>
                    <a asp-controller="Categories" asp-action="Index"
                       class="btn btn-info">
                        Manage Categories
                    </a>

                    <a asp-controller="Enrolments"
                       asp-action="OrganiserEnrolments"
                       class="btn btn-info mt-2">
                        Manage Enrolments
                    </a>
                }
                else if (role == "Participant")
                {
                    <h3>Participant Dashboard</h3>
                    <p>Discover upcoming events and track your progress.</p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary mt-3">
                        Browse Events
                    </a>

                    <a asp-controller="Enrolments"
                       asp-action="Index"
                       class="btn btn-info mt-2">
                        My Events
                    </a>
                }
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger mt-3">
                        Logout
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="text-center mt-4">
            <p>Please log in or create an account to get started.</p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary me-2">Login</a>

            <a asp-controller="Account"
               asp-action="Register"
               class="btn btn-outline-primary">Register</a>
        </div>
    }
</div>